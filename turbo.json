{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "REALTIME_AUTH_SECRET",
        "NEXT_PUBLIC_REALTIME_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "REALTIME_AUTH_SECRET",
        "NEXT_PUBLIC_REALTIME_URL"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
